import React, { useState, useEffect } from 'react';

function App() {
  const [produtos, setProdutos] = useState([]);
  const [nome, setNome] = useState('');
  const [preco, setPreco] = useState('');

  const API_URL = 'http://localhost:3000/produtos';

  // Buscar produtos (GET)
  const carregarProdutos = async () => {
    const resposta = await fetch(API_URL);
    const dados = await resposta.json();
    setProdutos(dados);
  };

  useEffect(() => {
    carregarProdutos();
  }, []);

  // Cadastrar produto (POST)
  const handleSubmit = async (e) => {
    e.preventDefault();

    await fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nome, preco: Number(preco) }),
    });

    setNome('');
    setPreco('');
    carregarProdutos();
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'Arial' }}>
      <h2>Cadastro de Produtos</h2>

      <form onSubmit={handleSubmit}>
        <div>
          <label>Nome: </label>
          <input type="text" value={nome} onChange={(e) => setNome(e.target.value)} required />
        </div>
        <div style={{ marginTop: '10px' }}>
          <label>Preço: </label>
          <input type="number" step="0.01" value={preco} onChange={(e) => setPreco(e.target.value)} required />
        </div>
        <button type="submit" style={{ marginTop: '10px' }}>Salvar</button>
      </form>

      <hr />

      <h3>Lista</h3>
      <ul>
        {produtos.map((p) => (
          <li key={p.id}>{p.nome} — R$ {p.preco}</li>
        ))}
      </ul>
    </div>
  );
}

export default App;

import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import { ValidationPipe } from '@nestjs/common';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  
  // Libera o acesso para o front-end
  app.enableCors();

  app.useGlobalPipes(new ValidationPipe());
  await app.listen(3000);
}
bootstrap();